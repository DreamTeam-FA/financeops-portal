# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_TEAM_PASSCODE: Fallback password for @marktimm.com email login.
# Used when Firebase email/password auth is not set up for a user.
VITE_TEAM_PASSCODE="your-secure-passcode-here"

# GOOGLE_SHEETS_API_KEY: Google Cloud API key with Sheets API enabled.
# Required so the server-side startup sync uses Sheets API v4 (bypasses active
# sheet filters) instead of falling back to the GViz public API (which only
# returns visible/filtered rows). The spreadsheet must allow "Anyone with link
# can view" access for the API key to work without OAuth.
# Create at: https://console.cloud.google.com/apis/credentials
# Restrict the key to: Google Sheets API only.
GOOGLE_SHEETS_API_KEY="YOUR_GOOGLE_SHEETS_API_KEY"
